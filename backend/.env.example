# Copy this file to backend/.env. Never commit credentials.
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/postroom

# preview records emails in MongoDB without contacting an SMTP server.
# Change to smtp only when you are ready to send real emails.
MAIL_MODE=preview
MAIL_FROM=Postroom <hello@example.com>

# For Gmail, use your full address and a Google App Password, not your password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
